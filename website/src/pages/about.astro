---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="About"
	description="Rank Journey SEO publishes SEO news and education — practical articles on search, so you can improve your site with confidence."
>
	<section class="page">
		<div class="measure">
			<p class="kicker">About</p>
			<h1 class="page-title">About Rank Journey SEO</h1>
			<div class="prose">
				<p>
					Rank Journey SEO publishes news and educational articles on SEO,
					search, AI, and the web. The writing is practical: what changed, what
					it means, and what to do on your site.
				</p>
				<p>
					If you work on a website and want it to perform in search, this is
					written for you.
				</p>
				<p>
					More about the person behind it will live here once that page is
					written properly.
				</p>
			</div>
		</div>
	</section>
</BaseLayout>
