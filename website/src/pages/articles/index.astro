---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout
	title="SEO Articles"
	description="Long-form guides on search engine optimisation to help you improve your site and show up where your audience is searching."
>
	<section class="page wrap">
		<p class="kicker">Guides and Information</p>
		<h1 class="page-title">SEO Articles</h1>
		<p class="lede">
			Long-form guides on how search works and ways to optimise your site for SEO.
		</p>

		{posts.length === 0 ? (
			<p class="empty-state">Articles will appear here.</p>
		) : (
			<ul class="post-list">
				{posts.map((post) => (
					<li>
						<PostCard post={post} />
					</li>
				))}
			</ul>
		)}
	</section>
</BaseLayout>
