---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/posts';
import { graph, organizationNode, personNode, websiteNode } from '../lib/schema';

const posts = await getPublishedPosts();
---

<BaseLayout
	title="Rank Journey SEO | SEO News and Guides"
	description="SEO news and in-depth guides to help you improve organic performance and get your site in front of the right searchers."
	jsonLd={graph([organizationNode(), personNode(), websiteNode()])}
>
	<section class="page wrap">
		<p class="kicker">SEO News and Education</p>
		<h1 class="page-title">Rank Journey SEO</h1>
		<p class="lede">
			SEO news and information to help you boost organic performance
			and drive quality traffic to your website.
		</p>

		{posts.length === 0 ? (
			<p class="empty-state">Articles will appear here.</p>
		) : (
			<ul class="post-list">
				{posts.map((post) => (
					<li>
						<PostCard post={post} />
					</li>
				))}
			</ul>
		)}
	</section>
</BaseLayout>
